<div class="navbar bg-base-100 shadow-sm  sticky z-50 top-0">
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
        </svg>
      </div>
      <ul tabindex="0"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow capitalize font-bold">
        <!-- mobile view -->
          <%=render 'shared/list_navbar'%>
      </ul>
    </div>
    <%=link_to "PdfBuilder" ,root_path,class:'btn btn-ghost text-xl'%>
  </div>
  <div class="navbar-end gap-4 ">
    <div class="hidden lg:flex text-2xl">
      <ul class="menu menu-horizontal px-1 capitalize font-bold">
       <%=render 'shared/list_navbar'%>
      </ul>
    </div>
    <div class="flex items-center gap-4">
      <% unless authenticated? %>
        <div>
          <%=link_to "login" , new_session_path,class:"hover:text-green-500 cursor-pointer"%>
        </div>
        <div><button class="btn btn-success btn-outline">Signup</button></div>
        <%end%>
          <div>
            <%= button_to "Log out" , session_path, method: :delete ,class:"btn btn-success btn-outline" if
              authenticated? %>

          </div>
          <% if authenticated? %>
            <div class="dropdown dropdown-bottom dropdown-end">
              <div tabindex="0" role="button" class=" m-1">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                  stroke="currentColor" class="size-10">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
              </div>
              <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm">
                <li>
                  <%=link_to "View Document" , fileview_path %>
                </li>

              </ul>
            </div>
            <%end%>

    </div>
    <div class="dropdown dropdown-hover dropdown-left dropdown-bottom">
      <div tabindex="0" role="button" class=" m-1">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
          class="size-10">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
        </svg>
      </div>
      <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm">
        <li><a>Item 1</a></li>
        <li><a>Item 2</a></li>
      </ul>
    </div>
  </div>

</div>