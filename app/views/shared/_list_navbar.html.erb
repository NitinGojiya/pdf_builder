<li class="hover:bg-[#4b5c1e] hover:text-white">
    <%=link_to "Merge Pdf" ,pdf_merge_path%>
</li>
<li class="hover:bg-[#4b5c1e] hover:text-white">
    <%=link_to "Compress Pdf" ,pdf_compress_path%>
</li>
<li class="hover:bg-[#4b5c1e] hover:text-white">
    <%=link_to "Split Pdf" ,pdf_split_path%>
</li>
<li class="hover:bg-[#4b5c1e] hover:text-white" data-controller="dropdown">
    <details data-dropdown-target="details">
        <summary>convert pdf</summary>
        <ul class="p-2 w-[300px] bg-[#E1EEBC]  text-black uppercase">
            <li>
                <%=link_to pdf_word_path do %>
                    <i class="fas fa-file-word"></i> pdf to word
                    <% end %>
            </li>
            <li>
                <%=link_to pdf_ppt_path do %>
                    <i class="fa-solid fa-file-powerpoint"></i>pdf to PowerPoint
                    <% end %>
            </li>
            <li>
                <%=link_to pdf_excel_path do%>
                    <i class="fa-solid fa-file-excel"></i> pdf to Excel
                    <% end %>
            </li>
            <li>
                <%=link_to pdf_jpg_path do %>
                    <i class="fa-solid fa-image"></i>pdf to jpg
                    <% end %>
            </li>
            <li>
                <%=link_to jpg_pdf_path do %>
                    <i class="fa-solid fa-file-pdf"></i> jpg to pdf
                    <% end %>
            </li>
            <li>
                <%=link_to word_pdf_path do %>
                <i class="fa-solid fa-file-word"></i> Word to  pdf
                <% end %>
            </li>
            <li>
                <%=link_to ppt_pdf_path do %>
                <i class="fa-solid fa-file-powerpoint"></i> PowerPoint to pdf
                <% end %>
            </li>
            <li>
                <%=link_to excel_pdf_path do %>
                <i class="fa-solid fa-file-excel"></i> excel to pdf
                <% end %>
            </li>
        </ul>
    </details>
</li>
<li data-controller="dropdown" class="hover:bg-[#4b5c1e] hover:text-white relative">
  <details data-dropdown-target="details">
    <summary>More PDF tools</summary>
    <ul class="p-2 bg-[#E1EEBC] text-black absolute z-10">
      <li>
        <%= link_to pdf_unlock_path do %>
          <i class="fa-solid fa-unlock"></i> Unlock PDF
        <% end %>
      </li>
      <li>
        <%= link_to pdf_lock_path do %>
          <i class="fa-solid fa-lock"></i> Lock PDF
        <% end %>
      </li>
      <li>
        <%= link_to pdf_rotate_path do %>
          <i class="fa-solid fa-rotate"></i> Rotate PDF
        <% end %>
      </li>
      <li>
        <%= link_to pdf_edit_path do %>
          <i class="fa-solid fa-edit"></i> Edit PDF
        <% end %>
      </li>
      <li>
        <%= link_to pdf_crop_path do %>
          <i class="fa-solid fa-crop"></i> Crop PDF
        <% end %>
      </li>
      <li>
        <%= link_to pdf_watermark_path do %>
          <i class="fa-solid fa-stamp"></i> Watermark PDF
        <% end %>
      </li>
      <li>
        <%= link_to pdf_sign_path do %>
          <i class="fa-solid fa-signature"></i> Sign PDF
        <% end %>
      </li>
    </ul>
  </details>
</li>
