<!-- Main container for the layout -->
<div class="flex flex-1 flex-col lg:flex-row">

    <!-- Left Content Area (File Display) -->
    <div
        class="flex-1 bg-white p-6 lg:p-10 flex flex-col items-center justify-center relative rounded-lg lg:rounded-none lg:rounded-l-lg shadow-md lg:shadow-none mx-4 my-4 lg:mx-0 lg:my-0">

        <!-- Header for small screens (hidden on large screens as the sidebar has it) -->
        <h1 class="text-2xl font-semibold text-gray-800 mb-6 lg:hidden">
            <%= dynamic_text.capitalize %>
        </h1>

        <!-- Container for PDF file cards - now allows multiple cards and wrapping -->
        <div class="flex flex-wrap justify-center gap-6 ">
            <div data-<%=stimulus_controller %>-target="previewContainer"
                class="flex flex-wrap justify-center gap-4 h-screen overflow-y-auto">
            </div>
            <!-- here the card of pdf view -->
        </div>

        <!-- Action Buttons (Add, Sort) - positioned absolutely for visual appeal -->
        <div class="absolute top-6 right-6 flex flex-col space-y-4">
            <!-- Add Button -->
            <button data-action="click-><%= stimulus_controller %>#select"
                class="w-12 h-12 bg-[#4b5c1e] hover:bg-[#819067] hover:text-black text-white rounded-full flex items-center justify-center shadow-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50"
                aria-label="Add more files">
                <i class="fas fa-plus text-xl"></i>
            </button>
            <!-- Sort Button -->
            <button
                class="w-12 h-12 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-full flex items-center justify-center shadow-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-opacity-50"
                aria-label="Sort files">
                <i class="fas fa-sort-alpha-down text-xl"></i>
            </button>
        </div>
    </div>

    <!-- Right Sidebar (Instructions and Merge Button) -->
    <div
        class="w-full lg:w-96 bg-white border-t lg:border-t-0 lg:border-l border-gray-200 shadow-lg lg:shadow-none flex flex-col rounded-lg lg:rounded-none lg:rounded-r-lg mx-4 mb-4 lg:mx-0 lg:my-0">
        <!-- Sidebar Header -->
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-2xl font-semibold text-gray-800">
                <%= dynamic_text.capitalize %>
            </h2>
        </div>

        <!-- Instructions Section -->
        <div class="flex-1 p-6 flex flex-col ">
            <div class="bg-blue-50 text-blue-800 p-4 rounded-lg text-sm leading-relaxed border border-blue-200">
                " <%= dynamic_dec %>"
            </div>
            <% if local_assigns[:watermark] %>
                <!-- 3x3 Dot Grid Position Picker -->
                 <div class="flex gap-1">
                    <div><p class="capitalize text-xl">position</p></div>
                     <div id="position-options"
                    class="grid grid-cols-3 gap-1 w-36 h-36 border border-gray-400 my-4 cursor-pointer">
                    <% positions=["top-left", "top-center" , "top-right" , "middle-left" , "center" , "middle-right", "bottom-left" , "bottom-center" , "bottom-right" ] %>
                        <% positions.each do |pos| %>
                            <button data-position="<%= pos %>"
                                class="position-cell relative border hover:bg-gray-200"></button>
                            <% end %>
                </div>
                 </div>


                <!-- Watermark Text Controls -->
                <div class="space-y-4 max-w-md">
                    <!-- Text Input -->
                    <div>
                        <label class=" text-sm font-semibold mb-1">Text:</label>
                        <input type="text" id="watermarkText" style="background-color: #fff;"
                            class="input input-accent bg-white text-black border border-gray-300"
                            placeholder="Watermark text" data-action="input->pdf-watermark#updateText" />

                    </div>

                    <!-- Format Options -->
                    <div>
                        <label class="block text-sm font-semibold mb-1">Text format:</label>
                        <div class="flex flex-wrap items-center gap-3">
                            <select id="fontFamily" class="select select-sm select-bordered"
                                data-action="change->pdf-watermark#updateFont">
                                <option selected>Arial</option>
                                <option>Times New Roman</option>
                                <option>Courier New</option>
                                <option>Verdana</option>
                                <option>Georgia</option>
                            </select>

                            <select id="fontSize" class="select select-sm select-bordered"
                                data-action="change->pdf-watermark#updateFontSize">
                                <option value="10">10pt</option>
                                <option value="12" selected>12pt</option>
                                <option value="14">14pt</option>
                                <option value="18">18pt</option>
                                <option value="24">24pt</option>
                            </select>

                            <button type="button" class="btn btn-sm btn-ghost font-bold"
                                data-action="click->pdf-watermark#toggleBold">B</button>
                            <button type="button" class="btn btn-sm btn-ghost italic"
                                data-action="click->pdf-watermark#toggleItalic">/</button>
                            <button type="button" class="btn btn-sm btn-ghost underline"
                                data-action="click->pdf-watermark#toggleUnderline">U</button>

                            <input type="color" id="textColor" value="#000000" class="w-8 h-8 border rounded-md"
                                data-action="change->pdf-watermark#updateColor" />
                        </div>
                    </div>
                </div>
                <% end %>

        </div>

        <!-- Merge PDF Button -->
        <div class="p-6 border-t border-gray-200 sticky bottom-10 right-0">

            <% if local_assigns[:password_required] %>
                <div>
                    <input type="text" id="pdfsecuritypassword" name="password" placeholder="Enter Password"
                        class="w-full p-3 border border-gray-300 rounded-lg mb-4 focus:outline-none focus:ring-2 focus:ring-[#4b5c1e] focus:border-transparent">
                </div>
                <% end %>



                    <div data-controller="<%=send_controller%>">
                        <button data-action="click-><%=send_controller%>#sendrequest"
                            class="w-full py-3 bg-[#4b5c1e] hover:bg-[#819067] hover:text-black text-white font-semibold rounded-lg shadow-lg flex items-center justify-center transition-colors duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
                            <i class="fas fa-file-pdf mr-2"></i>
                            <%= dynamic_text.capitalize %>
                        </button>
                    </div>

        </div>

    </div>

</div>