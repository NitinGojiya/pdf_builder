 <!-- Main container for the layout -->
    <div class="flex flex-1 flex-col lg:flex-row">

        <!-- Left Content Area (File Display) -->
        <div class="flex-1 bg-white p-6 lg:p-10 flex flex-col items-center justify-center relative rounded-lg lg:rounded-none lg:rounded-l-lg shadow-md lg:shadow-none mx-4 my-4 lg:mx-0 lg:my-0">

            <!-- Header for small screens (hidden on large screens as the sidebar has it) -->
            <h1 class="text-2xl font-semibold text-gray-800 mb-6 lg:hidden"> <%= dynamic_text.capitalize %></h1>
            <div class="flex flex-wrap justify-center gap-6">
            <!-- Container for PDF file cards - now allows multiple cards and wrapping -->
             <%#render 'pdf_edit'%>
        <div  data-pdf-edit-url-value="" data-pdf-edit-editable-value="true">

        <div class="status mb-4" data-pdf-edit-target="status"></div>

        <div class="flex">
            <!-- Thumbnail column -->
            <div class="w-1/4 p-2 overflow-y-auto" data-pdf-edit-target="thumbnailContainer"></div>

            <!-- Full page column -->
            <div class="w-3/4 p-2 h-screen overflow-y-auto" data-pdf-edit-target="fullContainer"></div>
        </div>

        <!-- Editor overlay (hidden by default) -->
        <div class="hidden" data-pdf-edit-target="editor"></div>


        <dialog id="my_modal_1" class="modal">
            <div class="modal-box">
                <div class="modal-action">
                    <form method="dialog">
                        <label for="textInput">Enter text:</label>
                        <input id="textInput" data-pdf-edit-target="text" class="border p-1" type="text" />
                        <button class="bg-blue-500 text-white px-4 py-2 rounded" type="submit">Add</button>
                    </form>
                </div>
            </div>
        </dialog>

         </div>
             </div>
        </div>

        <!-- Right Sidebar (Instructions and Merge Button) -->
        <div class="w-full lg:w-96 bg-white border-t lg:border-t-0 lg:border-l border-gray-200 shadow-lg lg:shadow-none flex flex-col rounded-lg lg:rounded-none lg:rounded-r-lg mx-4 mb-4 lg:mx-0 lg:my-0">
            <!-- Sidebar Header -->
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-2xl font-semibold text-gray-800">  <%= dynamic_text.capitalize %></h2>
            </div>

            <!-- Instructions Section -->
            <div class="flex-1 p-6 flex flex-col justify-between">
                <div class="bg-blue-50 text-blue-800 p-4 rounded-lg text-sm leading-relaxed border border-blue-200">
                    " <%= dynamic_dec %>"
                </div>
            </div>

            <!-- Merge PDF Button -->
            <div class="p-6 border-t border-gray-200 sticky bottom-10 right-0">

                <% if local_assigns[:password_required] %>
                    <div>
                        <input type="text"
                            id="pdfsecuritypassword"
                            name="password"
                            placeholder="Enter Password"
                            class="w-full p-3 border border-gray-300 rounded-lg mb-4 focus:outline-none focus:ring-2 focus:ring-[#4b5c1e] focus:border-transparent">
                    </div>
                    <% end %>


                <div data-controller="<%=send_controller%>">
                    <button
                data-action="click-><%=send_controller%>#sendrequest"
                class="w-full py-3 bg-[#4b5c1e] hover:bg-[#819067] hover:text-black text-white font-semibold rounded-lg shadow-lg flex items-center justify-center transition-colors duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
                    <i class="fas fa-file-pdf mr-2"></i>
                       <%= dynamic_text.capitalize %>
                </button>
                </div>

            </div>

        </div>

    </div>