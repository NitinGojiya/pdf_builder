<% content_for :title, "PDF Sign- Pdfbuilder" %>

    <div data-controller="pdf-sign" data-pdf-sign-url-value="" data-pdf-sign-editable-value="true">

        <div data-pdf-sign-target="preupload" class="flex justify-center">
            <%= render partial: "shared/upload_pdf" , locals: { dynamic_text: "Sign PDF" ,
                stimulus_controller: "pdf-sign" , send_controller: "pdf-sign" ,
                dynamic_dec: "Sign Your PDFs. Control Access. Ensure Privacy." , accept_files_types: "application/pdf" ,
                multiple_files: false } %>
        </div>

        <div class="hidden" id="postupload">
            <div class="status mb-4 z-50" data-pdf-sign-target="status"></div>

            <div class="flex flex-col md:flex-row h-screen">
                <!-- Main Editor -->
                <div class="w-full md:w-3/4 p-2 overflow-y-auto" data-pdf-sign-target="fullContainer">

                </div>
                <div
                    class="w-full lg:w-96 bg-white border-t lg:border-t-0 lg:border-l border-gray-200 shadow-lg lg:shadow-none flex flex-col rounded-lg lg:rounded-none lg:rounded-r-lg mx-4 mb-4 lg:mx-0 lg:my-0">
                    <!-- Sidebar Header -->
                    <div class="p-6 border-b border-gray-200">
                        <h2 class="text-2xl font-semibold text-gray-800">Sign pdf</h2>
                    </div>

                    <!-- edit element -->

                    <!--  PDF Button -->
                    <div class="p-6 border-t border-gray-200 sticky bottom-10 right-0">
                      <!-- "Create Sign" Button -->
                    <div class="p-6" id="editor-controls">
                    <button data-action="click->pdf-sign#openSignModal"
                        class="bg-[#4b5c1e] hover:bg-[#819067] hover:text-black text-white font-bold py-2 px-4 rounded">
                        Upload Sign
                    </button>
                    </div>

                    <!-- Signature Preview Area -->
                    <div class="p-6" id="signature-preview" data-pdf-sign-target="signaturePreview"></div>

                    <!-- Modal for Uploading Signature -->
                    <dialog id="my_modal_1" class="modal" data-pdf-sign-target="modal">
                    <div class="modal-box">
                        <h3 class="text-lg font-bold">Upload Signature</h3>
                        <p class="py-2">Select an image to use as your signature.</p>

                        <!-- File input -->
                            <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer hover:border-blue-500 hover:bg-blue-50 transition">
                            <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                <svg class="w-8 h-8 mb-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M7 16V4m0 0l-4 4m4-4l4 4M16 8h4m0 0v8m0-8l-4 4m4-4l-4-4M4 20h16" />
                                </svg>
                                <p class="mb-2 text-sm text-gray-500"><span class="font-semibold">Click to upload</span> or drag and drop</p>
                                <p class="text-xs text-gray-500">PNG, JPG, JPEG (max 5MB)</p>
                            </div>
                            <input type="file" accept="image/*"
                                data-action="change->pdf-sign#handleSignatureUpload"
                                data-pdf-sign-target="signatureInput"
                                class="hidden" />
                            </label>


                        <!-- Close button -->
                        <div class="modal-action">
                        <form method="dialog">
                            <button class="btn">Close</button>
                        </form>
                        </div>
                    </div>
                    </dialog>
                        <div>
                            <button data-action="click->pdf-sign#sendSignedPDFToRails"
                                class="w-full py-3 bg-[#4b5c1e] hover:bg-[#819067] hover:text-black text-white font-semibold rounded-lg shadow-lg flex items-center justify-center transition-colors duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
                                <i class="fas fa-file-pdf mr-2"></i>
                                Pdf Download
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="hidden" data-pdf-sign-target="editor"></div>
        </div>
    </div>