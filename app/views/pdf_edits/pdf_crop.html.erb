<% content_for :title, "PDF Crop- Pdfbuilder" %>

    <div data-controller="pdf-crop" data-pdf-crop-url-value="" data-pdf-crop-editable-value="true">

        <div data-pdf-crop-target="preupload" class="flex justify-center">
            <%= render partial: "shared/upload_pdf" , locals: { dynamic_text: "Crop PDF" ,
                stimulus_controller: "pdf-crop" , send_controller: "pdf-crop" ,
                dynamic_dec: "Crop Your PDFs. Control Access. Ensure Privacy." , accept_files_types: "application/pdf" ,
                multiple_files: false } %>
        </div>

        <div class="hidden" id="postupload">
            <div class="status mb-4" data-pdf-crop-target="status"></div>

            <div class="flex flex-col md:flex-row h-screen">
                <!-- Main Editor -->
                <div class="w-full md:w-3/4 p-2 overflow-y-auto" data-pdf-crop-target="fullContainer">

                </div>

                <div
                    class="w-full lg:w-96 bg-white border-t lg:border-t-0 lg:border-l border-gray-200 shadow-lg lg:shadow-none flex flex-col rounded-lg lg:rounded-none lg:rounded-r-lg mx-4 mb-4 lg:mx-0 lg:my-0">
                    <!-- Sidebar Header -->
                    <div class="p-6 border-b border-gray-200">
                        <h2 class="text-2xl font-semibold text-gray-800">crop pdf</h2>
                    </div>

                    <!-- edit element -->



                    <!--  PDF Button -->
                    <div class="p-6 border-t border-gray-200 sticky bottom-10 right-0">
                        <!-- Crop Tool Button -->
                        <div class="p-6" id="editor-controls">
                            <ol>
                                <li>Selection Area (Drag to Select)</li>
                                <li>Double-Click to Crop</li>
                            </ol>
                        </div>

                        <div>
                            <button data-action="click->pdf-crop#downloadEditedPDF"
                                class="w-full py-3 bg-[#4b5c1e] hover:bg-[#819067] hover:text-black text-white font-semibold rounded-lg shadow-lg flex items-center justify-center transition-colors duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
                                <i class="fas fa-file-pdf mr-2"></i>
                                Pdf Download
                            </button>

                        </div>

                    </div>


                </div>
            </div>

            <div class="hidden" data-pdf-crop-target="editor"></div>

        </div>

    </div>