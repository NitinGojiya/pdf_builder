<% content_for :title, "Watermark - Pdfbuilder" %>


<div class="flex items-center justify-center w-[100%]" data-controller="pdf-watermark">
  <div style="display: block;" data-pdf-watermark-target="uploadContainer">
      <%=render  partial: "shared/upload_pdf", locals: {
      dynamic_text: "Watermark pdf",
      stimulus_controller:"pdf-watermark",
      send_controller:"pdf-watermark",
      dynamic_dec:"Watermark PDFs in the order you want with the easiest PDF Splitter available.",
      accept_files_types: "application/pdf",
      multiple_files:false
    }
      %>
  </div>
  <div style="display: none;" class="min-h-screen flex flex-col" data-pdf-watermark-target="pdfmergeContainer">
   <%#render 'pdfsplitview'%>
    <%=render partial:'shared/preview_for_selected_file',locals: {
      dynamic_text: "Watermark pdf",
      send_controller:"pdf-watermark",
      dynamic_dec:"Watermark Pdf Unlimited, Effortless, and Always Free!",
      watermark:true,
      stimulus_controller:"pdf-watermark" } %>
  </div>
</div>