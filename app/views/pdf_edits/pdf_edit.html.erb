<% content_for :title, "PDF Edit- Pdfbuilder" %>

<div data-controller="pdf-edit" data-pdf-edit-url-value="" data-pdf-edit-editable-value="true">

    <div data-pdf-edit-target="preupload" class="flex justify-center">
        <%= render partial: "shared/upload_pdf" , locals: { dynamic_text: "Edit PDF" , stimulus_controller: "pdf-edit" ,
            send_controller: "pdf-edit" , dynamic_dec: "Edit Your PDFs. Control Access. Ensure Privacy." ,
            accept_files_types: "application/pdf" , multiple_files: false } %>
    </div>

    <div class="hidden" id="postupload">
        <div class="status mb-4" data-pdf-edit-target="status"></div>

        <div class="flex flex-col md:flex-row h-screen">
            <!-- Main Editor -->
            <div class="w-full md:w-3/4 p-2 overflow-y-auto" data-pdf-edit-target="fullContainer"></div>

            <!-- Change Log / Sidebar -->



            <div
                class="w-full lg:w-96 bg-white border-t lg:border-t-0 lg:border-l border-gray-200 shadow-lg lg:shadow-none flex flex-col rounded-lg lg:rounded-none lg:rounded-r-lg mx-4 mb-4 lg:mx-0 lg:my-0">
                <!-- Sidebar Header -->
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-2xl font-semibold text-gray-800">Edit pdf</h2>
                </div>

                <!-- edit element -->
                <div class="overflow-y-auto" data-pdf-edit-target="changesContainer"></div>


                    <!--  PDF Button -->
                    <div class="p-6 border-t border-gray-200 sticky bottom-10 right-0">
                        <div>
                            <button  data-action="click->pdf-edit#downloadEditedPDF"
                                class="w-full py-3 bg-[#4b5c1e] hover:bg-[#819067] hover:text-black text-white font-semibold rounded-lg shadow-lg flex items-center justify-center transition-colors duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
                                <i class="fas fa-file-pdf mr-2"></i>
                                Pdf Download
                            </button>
                        </div>

                    </div>


            </div>
        </div>

        <div class="hidden" data-pdf-edit-target="editor"></div>

        <dialog id="my_modal_1" class="modal">
            <div class="modal-box">
                <div class="modal-action">
                    <form method="dialog">
                        <label for="textInput">Enter text:</label>
                        <input id="textInput" data-pdf-edit-target="text" class="border p-1" type="text" />
                        <button class="bg-[#4b5c1e] hover:bg-[#819067] hover:text-black text-white px-4 py-2 rounded" type="submit">Add</button>
                    </form>
                </div>
            </div>
        </dialog>
    </div>

</div>
