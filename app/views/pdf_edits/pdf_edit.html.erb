<div data-controller="pdf-edit" data-pdf-edit-url-value="" data-pdf-edit-editable-value="true">

    <div class="status mb-4" data-pdf-edit-target="status"></div>

    <div class="flex">
        <!-- Thumbnail column -->
        <div class="w-1/4 p-2 overflow-y-auto" data-pdf-edit-target="thumbnailContainer"></div>

        <!-- Full page column -->
        <div class="w-3/4 p-2 h-screen overflow-y-auto" data-pdf-edit-target="fullContainer"></div>
    </div>

    <!-- Editor overlay (hidden by default) -->
    <div class="hidden" data-pdf-edit-target="editor"></div>


    <dialog id="my_modal_1" class="modal">
        <div class="modal-box">
            <div class="modal-action">
                <form method="dialog">
                    <label for="textInput">Enter text:</label>
                    <input id="textInput" data-pdf-edit-target="text" class="border p-1" type="text" />
                    <button class="bg-blue-500 text-white px-4 py-2 rounded" type="submit">Add</button>
                </form>
            </div>
        </div>
    </dialog>

</div>