 <!-- Main container for the Powerful PDF Tools section -->
    <div class="max-w-6xl mx-auto py-8">
        <!-- Section Header -->
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Powerful PDF Tools</h2>
        <!-- Section Description -->
        <p class="text-lg text-gray-600 mb-10">Our suite of tools provides everything you need to manage your PDF files efficiently.</p>

        <!-- Grid for PDF Tools -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
            <!-- Tool Card: Merge PDFs -->
            <%=link_to pdf_merge_url do%>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300 text-3xl mb-4">
                    <i class="fas fa-copy"></i> <!-- Icon for merge/copy -->
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Merge PDFs</h3>
                <p class="text-gray-600 text-sm ">Combine multiple PDFs into a single document.</p>
            </div>
            <%end%>
            <!-- Tool Card: split to PDF -->

            <%=link_to pdf_split_url do%>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300 text-3xl mb-4">
                   <i class="fa-solid fa-up-right-and-down-left-from-center"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Split PDF</h3>
                <p class="text-gray-600 text-sm">Transform documents, images, and more into PDFs.</p>
            </div>
            <%end%>

            <!-- Tool Card: Compress PDF -->
             <%=link_to pdf_compress_url do%>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300 text-3xl mb-4">
                    <i class="fas fa-compress-alt"></i> <!-- Icon for compress -->
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Compress PDF</h3>
                <p class="text-gray-600 text-sm">Reduce the file size of your PDFs without losing quality.</p>
            </div>
            <%end%>


            <!-- Tool Card: PDF to Word -->
            <%=link_to pdf_word_path do %>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300 text-3xl mb-4">
                    <i class="fas fa-file-word"></i> <!-- Icon for Word document -->
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">PDF to Word</h3>
                <p class="text-gray-600 text-sm">Convert PDFs to editable Word documents.</p>
            </div>
            <%end%>

            <!-- Tool Card: PDF to Power Point -->
            <%=link_to pdf_ppt_path do %>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300  text-3xl mb-4">
                   <i class="fa-solid fa-file-powerpoint"></i> <!-- Icon for ppt document -->
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">PDF to PPT</h3>
                <p class="text-gray-600 text-sm">Convert PDFs to editable PPT documents.</p>
            </div>
            <%end%>

            <!-- Tool Card: PDF to Excel -->
            <%=link_to pdf_excel_path do %>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300  text-3xl mb-4">
                   <i class="fa-solid fa-file-excel"></i> <!-- Icon for excel document -->
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">PDF to Excel</h3>
                <p class="text-gray-600 text-sm">Convert PDFs to editable Excel documents.</p>
            </div>
            <%end%>

            <!-- Tool Card: PDF to jpg -->
            <%=link_to pdf_jpg_path do %>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300  text-3xl mb-4">
                   <i class="fa-solid fa-image"></i> <!-- Icon for jpg document -->
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">PDF to JPG</h3>
                <p class="text-gray-600 text-sm">Convert PDFs to editable jpg documents.</p>
            </div>
            <%end%>

            <!-- Tool Card: jpg to pdf -->
            <%=link_to jpg_pdf_path do %>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300  text-3xl mb-4">
                   <i class="fa-solid fa-file-pdf"></i> <!-- Icon for jpg document -->
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">JPG to PDF</h3>
                <p class="text-gray-600 text-sm">Convert jpg to editable pdf documents.</p>
            </div>
            <%end%>

            <!-- Tool Card: word to pdf -->
            <%=link_to word_pdf_path do %>
            <div class="bg-white rounded-lg shadow-md h-[200px] p-6 flex flex-col items-start text-left border border-gray-200 hover:border-green-500 transition duration-300 ease-in-out cursor-pointer">
                <div class="text-green-300  text-3xl mb-4">
                   <i class="fa-solid fa-file-word"></i> <!-- Icon for word document -->
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">WORD to PDF</h3>
                <p class="text-gray-600 text-sm">Convert WORD to editable pdf documents.</p>
            </div>
            <%end%>
        </div>