<div class="flex items-center justify-center w-[100%]" data-controller="word-to-pdf">
  <div style="display: block;" data-word-to-pdf-target="uploadContainer">
    <%#render 'upload_pdf_for_word' %>
    <%=render  partial: "shared/upload_pdf", locals: {
      dynamic_text: "word to pdf convert",
      stimulus_controller:"word-to-pdf" ,
      dynamic_dec:"Convert your word files to  pdf documents with ease. Simply select your PDF files, and we will handle the conversion for you.",
      accept_files_types: "application/vnd.openxmlformats-officedocument.wordprocessingml.document, application/msword;q=0.9",
      multiple_files:false}  %>
  </div>
  <div style="display: none;" class="min-h-screen flex flex-col" data-word-to-pdf-target="pdfmergeContainer">
    <%=render partial:'shared/preview_for_selected_file',locals: {
      dynamic_text: "word",
      dynamic_dec:"Convert document to pdf Unlimited, Effortless, and Always Free!",
      stimulus_controller:"word-to-pdf" } %>
  </div>
</div>