<% content_for :title, "PPT To PDF - Pdfbuilder" %>


<div class="flex items-center justify-center w-[100%]" data-controller="ppt-to-pdf">
  <div style="display: block;" data-ppt-to-pdf-target="uploadContainer">
    <%#render 'upload_pdf_for_word' %>
    <%=render  partial: "shared/upload_pdf", locals: {
      dynamic_text: "ppt to pdf convert",
      stimulus_controller:"ppt-to-pdf" ,
      dynamic_dec:"Convert your ppt files to  pdf documents with ease. Simply select your PDF files, and we will handle the conversion for you.",
      accept_files_types: "application/vnd.openxmlformats-officedocument.presentationml.presentation, application/vnd.ms-powerpoint;q=0.9",
      multiple_files:false}  %>
  </div>
  <div style="display: none;" class="min-h-screen flex flex-col" data-ppt-to-pdf-target="pdfmergeContainer">
    <%=render partial:'shared/preview_for_selected_file',locals: {
      dynamic_text: "ppt to pdf convert",
      dynamic_dec:"Convert ppt to pdf Unlimited, Effortless, and Always Free!",
      stimulus_controller:"ppt-to-pdf" } %>
  </div>
</div>