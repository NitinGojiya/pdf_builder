<div class="flex items-center justify-center w-[100%]" data-controller="pdf-to-ppt">
  <div style="display: block;" data-pdf-to-ppt-target="uploadContainer">
    <%#render 'upload_pdf_for_word' %>
    <%=render  partial: "shared/upload_pdf", locals: {
       dynamic_text: "pdf to power point convert",
       stimulus_controller:"pdf-to-ppt",
       dynamic_dec:"Convert your PDF files to power point pdf documents with ease. Simply select your PDF files, and we will handle the conversion for you.",
       multiple_files:false }  %>
  </div>
  <div style="display: none;" class="min-h-screen flex flex-col" data-pdf-to-ppt-target="pdfmergeContainer">
    <%=render partial:'shared/preview_for_selected_file',locals: {
      dynamic_text: "power point",
      dynamic_dec:"Convert PDFs to power point Unlimited, Effortless, and Always Free!",
      stimulus_controller:"pdf-to-ppt" } %>
  </div>
</div>